#!/bin/sh
# Run the enforcement checks before anything leaves this machine.
#
# GOAL_2026-08-13 C1 asks that a CI run provisions a runner and executes a step.
# It cannot be satisfied from the repository. GitHub's own annotation on every
# run since 2026-07-26 reads:
#
#   "The job was not started because recent account payments have failed or your
#    spending limit needs to be increased."
#
# That is fixed in Settings -> Billing & plans, by the account owner, and no
# amount of YAML changes it. This hook is the part that *is* reachable: it makes
# the static enforcement checks run automatically on every push, on this machine,
# with no runner and no minutes.
#
# Only the checks that need nothing to provision are here. The PostgreSQL
# verifiers, the broker and object-store rehearsals and the browser matrix are
# declared MANUAL in oms/check_registry.py with their cadences, and belong to a
# runner that can start services. Putting them here would make the hook slow
# enough to be bypassed, which is the failure mode this whole goal is about.
#
# Measured at about 10 seconds total. To skip in an emergency: git push --no-verify
# -- stated plainly, because a hook that pretends to be unavoidable is not.
#
# Two things were wrong with this hook on every machine that is not the one it
# was written on, and both made it silent rather than loud:
#
#   1. `python` is not a command on a stock macOS or a modern Linux; `python3`
#      is. The hook resolved `${PYTHON:-python}` and died on its first check
#      with "command not found", which reads like a broken hook rather than a
#      missing interpreter. It now walks a list and says which one it took.
#   2. Two of these checks import the application, so they need the pinned
#      requirements installed. Reporting that as FAIL put a dependency gap and
#      a real regression under one word. `unavailable` is now counted apart,
#      the way tier-a-baseline.json counts it, and still blocks the push --
#      a machine that cannot run half the gate has not passed it.

set -e
root=$(git rev-parse --show-toplevel)
cd "$root"

# Take the first interpreter that exists, unless PYTHON says otherwise. The
# repository's venv comes before the system one: it is the only one that has the
# pinned requirements, and preferring it is what makes the two importing checks
# run at all.
if [ -n "${PYTHON:-}" ]; then
    python=$PYTHON
else
    python=""
    for candidate in "$root/oms/venv/bin/python" "$root/.venv/bin/python" python3.12 python3 python; do
        if command -v "$candidate" >/dev/null 2>&1; then
            python=$candidate
            break
        fi
    done
    if [ -z "$python" ]; then
        echo "pre-push: no python interpreter found. Set PYTHON=/path/to/python and retry." >&2
        exit 1
    fi
fi

echo "pre-push: running enforcement checks with $python ($("$python" --version 2>&1))"

checks="audit_enforcement audit_check_coverage audit_evidence_corpus audit_query_bounds audit_object_writes audit_auth_coverage audit_tenancy_scope audit_extensibility audit_latency_observations audit_route_coverage audit_snapshot_scope validate_schema_freeze"

failed=""
unavailable=""
for check in $checks; do
    if "$python" "oms/$check.py" >"/tmp/pre-push-$check.log" 2>&1; then
        printf '  ok           %s\n' "$check"
    elif grep -q "ModuleNotFoundError" "/tmp/pre-push-$check.log"; then
        # The check did not judge the tree. That is not a pass and not a
        # regression; naming it separately is the difference between "fix the
        # code" and "install the requirements".
        printf '  unavailable  %s (%s)\n' "$check" \
            "$(grep -m1 ModuleNotFoundError "/tmp/pre-push-$check.log" | sed 's/.*No module named //')"
        unavailable="$unavailable $check"
    else
        printf '  FAIL         %s\n' "$check"
        failed="$failed $check"
    fi
done

if [ -n "$unavailable" ]; then
    echo
    echo "pre-push blocked. Checks that could not run:$unavailable"
    echo "These import the application. Install the pinned requirements, then retry:"
    echo "  python3 -m venv oms/venv && oms/venv/bin/pip install -r oms/requirements.txt"
fi

if [ -n "$failed" ]; then
    echo
    echo "pre-push blocked. Failing checks:$failed"
    for check in $failed; do
        echo "--- $check ---"
        tail -12 "/tmp/pre-push-$check.log"
    done
    echo
    echo "Fix the ratchet, or push with --no-verify if you have a reason and will say what it is."
fi

if [ -n "$failed" ] || [ -n "$unavailable" ]; then
    exit 1
fi

echo "pre-push: all enforcement checks passed"
exit 0
