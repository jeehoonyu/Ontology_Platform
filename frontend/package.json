{
  "name": "ontology-platform-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:production-oidc": "playwright test -c playwright.production.config.ts oidc-rbac.spec.ts",
    "test:production-oidc-scale": "playwright test -c playwright.production.config.ts oidc-scale.spec.ts",
    "test:production-plugin-executor": "playwright test -c playwright.production.config.ts plugin-executor.spec.ts",
    "test:production-pipeline-worker": "playwright test -c playwright.production.config.ts pipeline-worker-recovery.spec.ts",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.101.4",
    "@vitejs/plugin-react": "^5.1.1",
    "@xyflow/react": "^12.11.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.25.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-leaflet": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3"
  },
  "overrides": {
    "browserslist": "^4.28.8"
  }
}
