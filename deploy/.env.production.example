PUBLIC_HOST=ontology.example.com
PUBLIC_BASE_URL=https://ontology.example.com
POSTGRES_USER=ontology
POSTGRES_PASSWORD=replace-with-a-long-random-secret
POSTGRES_DB=ontology
AUTH_MODE=oidc
OIDC_ISSUER=https://identity.example.com/realms/ontology
OIDC_CLIENT_ID=ontology-platform
OIDC_CLIENT_SECRET=replace-if-confidential-client
SESSION_TTL_SECONDS=28800
FORWARDED_ALLOW_IPS=172.16.0.0/12
CONNECTOR_SECRET_KEY=replace-with-a-separate-long-random-secret
CONNECTOR_SECRET_KEY_ID=production-v1
CONNECTOR_ALLOWED_HOSTS=api.example.com,db.example.internal
CONNECTOR_ALLOW_PRIVATE_NETWORKS=false
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-for-demo-profile
