PUBLIC_HOST=ontology.example.com
PUBLIC_BASE_URL=https://ontology.example.com
WEBSOCKET_ALLOWED_ORIGINS=https://ontology.example.com
POSTGRES_USER=ontology
POSTGRES_PASSWORD=replace-with-a-long-random-secret
POSTGRES_DB=ontology
AUTH_MODE=oidc
ONTOLOGY_CONTRACT_ENFORCEMENT=strict
OIDC_ISSUER=https://identity.example.com/realms/ontology
# Optional private address for API-to-provider discovery, token, and JWKS calls.
OIDC_BACKCHANNEL_BASE_URL=
OIDC_CLIENT_ID=ontology-platform
OIDC_CLIENT_SECRET=replace-if-confidential-client
SESSION_TTL_SECONDS=28800
FORWARDED_ALLOW_IPS=172.16.0.0/12
CONNECTOR_SECRET_KEY=replace-with-a-separate-long-random-secret
CONNECTOR_SECRET_KEY_ID=production-v1
PILOT_RECOVERY_TOKEN=replace-with-at-least-32-random-characters
# Use an absolute host directory for the complete RPO/RTO pilot scheduler.
# Leave empty to retain the Docker named volume for availability-only collection.
PILOT_EVIDENCE_PATH=
# Reference isolated-recovery driver. PILOT_SOURCE_COMPOSE_FILES uses the host
# path-list separator (`:` on Linux, `;` on Windows) when multiple files are used.
PILOT_SOURCE_URL=https://ontology.example.com
PILOT_RECOVERY_URL=http://127.0.0.1:18002
PILOT_RECOVERY_PORT=18002
PILOT_SOURCE_COMPOSE_FILES=docker-compose.yml:docker-compose.production.yml
PILOT_SOURCE_PROJECT=ontology_platform
PILOT_RECOVERY_COMPOSE_FILE=docker-compose.pilot-recovery.yml
PILOT_RECOVERY_PROJECT=ontology_pilot_recovery
PILOT_BACKUP_ROOT=/var/lib/ontology/pilot-backups
PILOT_BACKUP_SNAPSHOTS=true
PILOT_BACKUP_PLUGINS=true
PILOT_BACKUP_RETENTION_COUNT=24
PILOT_BACKUP_INTEGRITY_KEY=replace-with-a-separate-32-character-random-secret
PILOT_RECOVERY_READY_TIMEOUT_SECONDS=900
# Immutable application image used by the isolated restored API.
ONTOLOGY_IMAGE=registry.example.com/ontologyos/api@sha256:replace-with-release-digest
CONNECTOR_ALLOWED_HOSTS=api.example.com,db.example.internal,s3.*.amazonaws.com
CONNECTOR_ALLOW_PRIVATE_NETWORKS=false
CONNECTOR_KAFKA_ALLOW_PLAINTEXT=false
DATA_SNAPSHOT_BACKEND=local
DATA_SNAPSHOT_ROOT=/var/lib/ontology/snapshots
# Set these when DATA_SNAPSHOT_BACKEND=s3 (MinIO and AWS S3 are supported).
DATA_SNAPSHOT_BUCKET=
DATA_SNAPSHOT_S3_ENDPOINT=
DATA_SNAPSHOT_S3_REGION=us-east-1
DATA_SNAPSHOT_S3_ADDRESSING_STYLE=auto
DATA_SNAPSHOT_S3_AUTO_CREATE_BUCKET=false
DATA_SNAPSHOT_CACHE_ROOT=/var/cache/ontology/snapshots
DATA_SNAPSHOT_CACHE_MAX_BYTES=21474836480
DATA_SNAPSHOT_CACHE_LEASE_SECONDS=3600
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MODEL_GATEWAY_ALLOWED_HOSTS=models.example.com
MODEL_GATEWAY_ALLOW_PRIVATE_NETWORKS=false
PLUGIN_BUNDLE_ROOT=/var/lib/ontology/plugins
PLUGIN_BUNDLE_MAX_BYTES=10485760
# Production API queues work and never receives an OCI socket. Enable the
# plugin-execution Compose profile and issue this executor an execute-only token.
PLUGIN_EXECUTION_MODE=worker
PLUGIN_EXECUTOR_TOKEN=replace-with-an-execute-only-service-token
PLUGIN_EXECUTOR_NAME=ontology-plugin-executor-1
PLUGIN_EXECUTOR_PROJECT_ID=default
PLUGIN_EXECUTOR_LEASE_SECONDS=600
# The dedicated OCI daemon pulls this immutable image. It must contain
# plugin_sandbox_runner.py and Python 3.
PLUGIN_SANDBOX_IMAGE=registry.example.com/ontologyos/plugin-sandbox@sha256:replace-with-image-digest
PLUGIN_SANDBOX_RUNNER_PATH=/app/app/plugin_sandbox_runner.py
# Required only for plugins declaring network. The executor creates this as an
# internal-only network and provisions the digest-pinned proxy inside its OCI daemon.
PLUGIN_SANDBOX_NETWORK=ontology-plugin-egress
PLUGIN_EGRESS_PROXY_IMAGE=registry.example.com/ontologyos/plugin-egress-proxy@sha256:replace-with-image-digest
PLUGIN_EGRESS_PROXY_URL=http://plugin-egress-proxy:8080
PLUGIN_EGRESS_PROXY_NAME=plugin-egress-proxy
PLUGIN_EGRESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
WORKER_TOKEN=
WORKER_NAME=ontology-worker-1
WORKER_PROJECT_ID=default
WORKER_JOB_TYPES=pipeline.preview,pipeline.deliver,pipeline.duckdb.preview,pipeline.duckdb.deliver,industrial.ontology_hydrate,aip.agent.invoke,ingestion.connector_sync,ingestion.stream_replay,stream.process,event.dispatch,event.stream.route
# Add event.kafka.dispatch after configuring the broker settings below.
EVENT_KAFKA_BOOTSTRAP_SERVERS=
EVENT_KAFKA_SECURITY_PROTOCOL=SASL_SSL
EVENT_KAFKA_SASL_MECHANISM=PLAIN
EVENT_KAFKA_SASL_USERNAME=
EVENT_KAFKA_SASL_PASSWORD=
EVENT_KAFKA_TOPIC_PREFIX=ontologyos
EVENT_KAFKA_ALLOW_PLAINTEXT=false
EVENT_KAFKA_REQUEST_TIMEOUT_MS=30000
EVENT_KAFKA_MAX_BLOCK_MS=10000
WORKER_CONCURRENCY=2
WORKER_LEASE_SECONDS=120
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-for-demo-profile
